# PostgreSQL pooled/runtime and direct migration connections
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=""
# Canonical public origin used in password-reset and verification links.
AUTH_URL="http://localhost:3000"
# Legacy Auth.js deployments may use NEXTAUTH_URL instead of AUTH_URL.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional OAuth providers (both values are required to enable a provider)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Email delivery via Resend (development logs links when these are omitted)
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Store with AI <auth@example.com>"
